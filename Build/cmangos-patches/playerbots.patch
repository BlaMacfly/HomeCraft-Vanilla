+// ---------------------------------------------------------------- HomeCraft : repli et intentions de jeu
+
+#include <ctime>
+#include <map>
+#include <mutex>
+
+static std::atomic<time_t> homecraftLlmUnavailableUntil{0};
+static std::mutex homecraftIntentLock;
+static std::multimap<std::uint64_t, std::pair<std::uint64_t, std::string>> homecraftIntents;
+
+bool PlayerbotLLMInterface::IsAvailable()
+{
+    return time(nullptr) >= homecraftLlmUnavailableUntil.load();
+}
+
+void PlayerbotLLMInterface::ReportResult(bool ok)
+{
+    if (ok)
+        homecraftLlmUnavailableUntil = 0;
+    else
+    {
+        if (IsAvailable())
+            sLog.outError("BotLLM: génération en échec, réponses classiques des bots pendant 60 s");
+        homecraftLlmUnavailableUntil = time(nullptr) + 60;
+    }
+}
+
+bool PlayerbotLLMInterface::IsAllowedIntent(const std::string& intent)
+{
+    static const char* const allowed[] = { "follow", "stay", "attack", "wave", "bow", "cheer", "laugh", "salute" };
+    for (const char* a : allowed)
+        if (intent == a)
+            return true;
+    return false;
+}
+
+void PlayerbotLLMInterface::ExtractIntents(std::vector<std::string>& lines, std::uint64_t bot, std::uint64_t sender)
+{
+    static const std::regex tag(R"(^\s*\[hc:([a-z_]{1,16})\]\s*$)");
+    std::vector<std::string> kept;
+    for (const std::string& line : lines)
+    {
+        std::smatch m;
+        if (std::regex_match(line, m, tag))
+        {
+            std::string intent = m[1].str();
+            // Une seule intention par réponse, toujours de la liste blanche ; le reste est ignoré sans être dit.
+            if (bot && sender && IsAllowedIntent(intent))
+            {
+                std::lock_guard<std::mutex> guard(homecraftIntentLock);
+                if (homecraftIntents.count(bot) == 0)
+                    homecraftIntents.emplace(bot, std::make_pair(sender, intent));
+            }
+            continue;
+        }
+        if (line.find("[hc:") != std::string::npos)
+            continue;
+        kept.push_back(line);
+    }
+    lines.swap(kept);
+}
+
+std::vector<std::pair<std::uint64_t, std::string>> PlayerbotLLMInterface::TakeIntents(std::uint64_t bot)
+{
+    std::vector<std::pair<std::uint64_t, std::string>> out;
+    std::lock_guard<std::mutex> guard(homecraftIntentLock);
+    auto range = homecraftIntents.equal_range(bot);
+    for (auto it = range.first; it != range.second; ++it)
+        out.push_back(it->second);
+    homecraftIntents.erase(range.first, range.second);
+    return out;
+}
