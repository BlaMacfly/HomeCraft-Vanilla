+WorldSession* World::FindSessionForCallback(uint32 id) const
+{
+    if (!getConfig(CONFIG_BOOL_HOMECRAFT_MULTI_SESSION))
+        return FindSession(id);
+
+    for (auto const& itr : m_sessions)
+        if (itr.second && itr.second->GetCallbackKey() == id)
+            return itr.second;
+    return nullptr;
+}
+
+WorldSession* World::FindSessionForReconnect(uint32 id) const
+{
+    if (!getConfig(CONFIG_BOOL_HOMECRAFT_MULTI_SESSION))
+        return FindSession(id);
+
+    auto range = m_sessions.equal_range(id);
+    for (auto itr = range.first; itr != range.second; ++itr)
+        if (itr->second && itr->second->IsOffline())
+            return itr->second;
+    return nullptr;
+}
